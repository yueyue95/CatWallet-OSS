NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Docker-only server URL for SSR/middleware. Compose defaults this to the
# host gateway for the local Supabase stack; leave it unset for host dev.
# SUPABASE_SERVER_URL=http://host.docker.internal:56431

# Docker Compose reads the same variables from .env.local at runtime.
# Apply all SQL migrations in supabase/migrations before first login.

# Server-only. AES-256-GCM key for application-layer PII encryption (base64, 32 bytes).
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# Keep secrets out of the repository.
# Add any future public-only client variables here as placeholders.

# Local-only MCP Streamable HTTP contract (optional; no token belongs here).
# CATWALLET_MCP_RESOURCE_URL=http://localhost:3000/api/mcp
# CATWALLET_MCP_AUTHORIZATION_SERVER_URL=http://localhost:56431/auth/v1
# CATWALLET_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# CATWALLET_MCP_ALLOWED_ORIGINS=localhost,127.0.0.1
# CATWALLET_MCP_BODY_LIMIT_BYTES=1048576
# CATWALLET_MCP_TIME_ZONE=Asia/Kuala_Lumpur
# Production/cloud resource-server contract (set only in the hosting platform):
# CATWALLET_MCP_EXPECTED_ISSUER=https://your-project-ref.supabase.co/auth/v1
# CATWALLET_MCP_EXPECTED_AUDIENCE=authenticated
# CATWALLET_MCP_REQUIRED_SCOPES=openid
# CATWALLET_MCP_CONSENT_PATH=/oauth/consent
